# ─────────────────────────────────────────────────────────────────────────────
# InterviewHub — переменные окружения для docker-compose.hypex.yml.
# Скопировать в `.env` рядом с compose и заполнить реальными значениями:
#     cp .env.example .env && nano .env
# `.env` в .gitignore — НЕ коммитить.
#
# Формат ключей ASP.NET Core: Секция__Ключ (двойное подчёркивание),
# массивы — Секция__Ключ__0.
#
# Проверка перед первым деплоем:
#     grep -c CHANGE_ME .env      # должно быть 0
# ─────────────────────────────────────────────────────────────────────────────

# --- PostgreSQL (образ postgres) ---
POSTGRES_DB=interviewhub
POSTGRES_USER=interviewhub
# openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Строка подключения API ---
# Host=postgres — имя сервиса в compose-сети, а не localhost.
# Пароль обязан совпадать с POSTGRES_PASSWORD выше: рассинхрон этих двух
# мест — самая частая ошибка при заполнении .env.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=interviewhub;Username=interviewhub;Password=CHANGE_ME_strong_db_password

# --- JWT (критично) ---
# API падает на старте, если ключ короче 32 символов — это намеренно.
# openssl rand -base64 48
Jwt__Key=CHANGE_ME_generate_a_long_random_secret_min_32_chars
Jwt__Issuer=interview.hypex.site
Jwt__Audience=interview.hypex.site

# --- CORS ---
# Фронт ходит по относительному /api через nginx того же домена, поэтому
# CORS ему не нужен. Origin указан для внешних клиентов и на случай,
# если SPA когда-нибудь переедет на другой домен.
Cors__AllowedOrigins__0=https://interview.hypex.site

# --- Разрешённые Host-заголовки (защита от host-header атак) ---
AllowedHosts=interview.hypex.site

# --- Первый админ ---
# Создаётся при старте, только если в системе ещё нет ни одного админа.
# Публичной регистрации нет — без этих значений админку будет некому открыть.
Bootstrap__Admin__Email=admin@interview.hypex.site
# Сильный уникальный пароль. Сменить после первого входа: /admin → Пользователи.
Bootstrap__Admin__Password=CHANGE_ME_strong_admin_password
Bootstrap__Admin__Name=Администратор
